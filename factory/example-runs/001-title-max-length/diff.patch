+def test_sr_1_3_title_at_most_80_characters():
+    message = "Title must be at most 80 characters."
+    with pytest.raises(ValidationError) as too_long:
+        create_task("x" * 81)
+    assert str(too_long.value) == message
+    assert create_task("x" * 80).title == "x" * 80
+    # The length is measured after surrounding whitespace is stripped.
+    assert create_task("  " + "x" * 80 + "  ").title == "x" * 80
+    with pytest.raises(ValidationError) as padded_too_long:
+        create_task("  " + "x" * 81 + "  ")
+    assert str(padded_too_long.value) == message
+
