+def test_sr_1_1_blank_title_rejected():
+    for blank in ["", "   ", "\t\n"]:
+        with pytest.raises(ValidationError) as excinfo:
+            create_task(blank)
+        assert str(excinfo.value) == "Title is required."
+
+    assert create_task("Buy milk") == Task(title="Buy milk")
+
